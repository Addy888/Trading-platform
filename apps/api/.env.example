# Database Configuration
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/tradeing_db"

# Database Connection (for Prisma 7 adapter)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="tradeing_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Admin (only for initial setup via seed script)
ADMIN_EMAIL="admin@tradeing.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"

# Development-only simulated test account funding.
# Keep disabled by default; list only approved development/test user IDs.
# This option is always rejected when NODE_ENV=production.
SIMULATED_TEST_FUNDING_ENABLED="false"
SIMULATED_TEST_USER_IDS=""
SIMULATED_TEST_INITIAL_BALANCE="10000.00"

# Email Configuration (Day 9)
# EMAIL_ENABLED: Enable/disable email notifications
# EMAIL_FROM: Sender email address
# EMAIL_TRANSPORT: Transport type (development, smtp, etc.)
# IMPORTANT: Default is false. Development mode does NOT send real emails.
EMAIL_ENABLED="false"
EMAIL_FROM="no-reply@example.local"
EMAIL_TRANSPORT="development"

# Angel One SmartAPI Configuration (Real Broker Integration - Day 1)
# These credentials are USER-SPECIFIC. Each user needs their own Angel One account.
# Obtain these from your Angel One demat account with API access enabled.
ANGELONE_API_KEY="your-angel-one-api-key"
ANGELONE_CLIENT_ID="your-client-id"
ANGELONE_PASSWORD="your-trading-password"
ANGELONE_TOTP_SECRET="your-totp-secret-for-2fa"
ANGELONE_ENCRYPTION_KEY="your-32-character-encryption-key-here"

# Twelve Data market data (backend only; does not enable order execution)
# NestJS loads apps/api/.env regardless of the backend process working directory.
# OS-provided environment variables take precedence over values in that file.
# Never expose this key to the browser or through NEXT_PUBLIC_* variables.
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_TIMEOUT_MS=15000

# Market-data polling and cache settings (milliseconds)
# MARKET_DATA_QUOTE_CACHE_TTL: Cache duration for quotes in milliseconds (default: 900000 = 15min)
# MARKET_DATA_CANDLE_CACHE_TTL: Cache duration for candles in milliseconds (default: 300000 = 5min)
# MARKET_DATA_POLLING_INTERVAL: Minimum polling frequency in milliseconds (default: 900000 = 15min)
MARKET_DATA_QUOTE_CACHE_TTL="900000"
MARKET_DATA_CANDLE_CACHE_TTL="300000"
MARKET_DATA_POLLING_INTERVAL="900000"
MARKET_DATA_STALE_THRESHOLD_MS="1200000"

# CORS Configuration (Production)
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000"

# Rate Limiting (API Protection)
# TTL: Time window in seconds
# LIMIT: Maximum requests per TTL window
RATE_LIMIT_TTL="60"
RATE_LIMIT_MAX="100"

# Stripe Payment Gateway Configuration
# Obtain API keys from https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_, live keys start with sk_live_
# Webhook secret: https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Application URL (for payment redirects)
APP_URL="http://localhost:3000"
