# Database Configuration
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/tradeing_db"

# Database Connection (for Prisma 7 adapter)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_password"
DB_NAME="tradeing_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Admin (only for initial setup via seed script)
ADMIN_EMAIL="admin@tradeing.local"
ADMIN_PASSWORD="Admin123!SecurePassword"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"

# Simulated Market Engine (Day 8)
SIMULATED_MARKET_ENABLED="true"
MARKET_UPDATE_INTERVAL_MS="3000"

# Email Configuration (Day 9)
# EMAIL_ENABLED: Enable/disable email notifications
# EMAIL_FROM: Sender email address
# EMAIL_TRANSPORT: Transport type (development, smtp, etc.)
# IMPORTANT: Default is false. Development mode does NOT send real emails.
EMAIL_ENABLED="false"
EMAIL_FROM="no-reply@example.local"
EMAIL_TRANSPORT="development"
