// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

enum RuleType {
  PROFIT_TARGET
  DAILY_LOSS
  MAX_DRAWDOWN
  MIN_TRADING_DAYS
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TradingAccountStatus {
  PENDING
  ACTIVE
  PASSED
  BREACHED
  SUSPENDED
  CLOSED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum NotificationType {
  ACCOUNT_CREATED
  TRADE_OPENED
  TRADE_CLOSED
  ACCOUNT_PASSED
  ACCOUNT_BREACHED
  ORDER_CREATED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  PAYMENT_REJECTED
  SYSTEM_ALERT
  ADMIN_ALERT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  RESUBMISSION_REQUESTED
}

enum PaymentStatusExtended {
  PENDING
  PROCESSING
  SUCCESS
  COMPLETED
  FAILED
  REJECTED
  REFUNDED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  country          String?
  role             Role     @default(USER)
  isEmailVerified  Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]               @relation("ActorAuditLogs")
  orders                 Order[]
  tradingAccounts        TradingAccount[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  payouts                Payout[]
  kycSubmissions         KycSubmission[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model TradingRule {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  type          RuleType
  value         Decimal  @db.Decimal(10, 2)
  isPercentage  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleSetRules  RuleSetRule[]

  @@map("trading_rules")
}

model RuleSet {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ruleSetRules  RuleSetRule[]
  challengePlans ChallengePlan[]
  tradingAccounts TradingAccount[]

  @@map("rule_sets")
}

model RuleSetRule {
  id         String   @id @default(uuid())
  ruleSetId  String
  ruleId     String
  createdAt  DateTime @default(now())

  ruleSet    RuleSet     @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  rule       TradingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, ruleId])
  @@map("rule_set_rules")
}

model ChallengePlan {
  id          String          @id @default(uuid())
  name        String
  description String?         @db.Text
  accountSize Decimal         @db.Decimal(12, 2)
  price       Decimal         @db.Decimal(10, 2)
  currency    String          @default("USD")
  status      ChallengeStatus @default(DRAFT)
  ruleSetId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  ruleSet     RuleSet         @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  orders      Order[]
  tradingAccounts TradingAccount[]

  @@map("challenge_plans")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  challengePlanId String
  amount          Decimal     @db.Decimal(10, 2)
  currency        String
  status          OrderStatus @default(PENDING)
  planSnapshot    Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengePlan   ChallengePlan  @relation(fields: [challengePlanId], references: [id], onDelete: Restrict)
  payment         Payment?
  tradingAccount  TradingAccount?

  @@map("orders")
}

model Payment {
  id                String                 @id @default(uuid())
  orderId           String                 @unique
  amount            Decimal                @db.Decimal(10, 2)
  currency          String
  status            PaymentStatusExtended  @default(PENDING)
  provider          String                 @default("MANUAL_TEST")
  providerReference String?
  method            String?
  reference         String?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model TradingAccount {
  id              String               @id @default(uuid())
  userId          String
  challengePlanId String
  orderId         String               @unique
  ruleSetId       String
  accountNumber   String               @unique
  initialBalance  Decimal              @db.Decimal(12, 2)
  currentBalance  Decimal              @db.Decimal(12, 2)
  equity          Decimal              @db.Decimal(12, 2)
  status          TradingAccountStatus @default(ACTIVE)
  startedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengePlan   ChallengePlan        @relation(fields: [challengePlanId], references: [id], onDelete: Restrict)
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ruleSet         RuleSet              @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  trades          Trade[]
  snapshots       AccountSnapshot[]

  @@index([userId, status])
  @@map("trading_accounts")
}

model Trade {
  id               String      @id @default(uuid())
  tradingAccountId String
  symbol           String
  side             TradeSide
  volume           Decimal     @db.Decimal(10, 4)
  entryPrice       Decimal     @db.Decimal(18, 8)
  exitPrice        Decimal?    @db.Decimal(18, 8)
  stopLoss         Decimal?    @db.Decimal(18, 8)
  takeProfit       Decimal?    @db.Decimal(18, 8)
  status           TradeStatus @default(OPEN)
  realizedPnl      Decimal     @db.Decimal(12, 2) @default(0)
  unrealizedPnl    Decimal     @db.Decimal(12, 2) @default(0)
  openedAt         DateTime    @default(now())
  closedAt         DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@map("trades")
}

model AccountSnapshot {
  id               String   @id @default(uuid())
  tradingAccountId String
  balance          Decimal  @db.Decimal(12, 2)
  equity           Decimal  @db.Decimal(12, 2)
  realizedPnl      Decimal  @db.Decimal(12, 2)
  unrealizedPnl    Decimal  @db.Decimal(12, 2)
  totalPnl         Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@index([tradingAccountId, createdAt])
  @@map("account_snapshots")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  title     String
  message   String               @db.Text
  data      Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  inAppEnabled           Boolean  @default(true)
  emailEnabled           Boolean  @default(false)
  tradeNotifications     Boolean  @default(true)
  accountNotifications   Boolean  @default(true)
  challengeNotifications Boolean  @default(true)
  orderNotifications     Boolean  @default(true)
  systemNotifications    Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Payout {
  id                String        @id @default(uuid())
  userId            String
  tradingAccountId  String
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  status            PayoutStatus  @default(PENDING)
  method            String?
  destination       String?       @db.Text
  reference         String?
  notes             String?       @db.Text
  requestedAt       DateTime      @default(now())
  processedAt       DateTime?
  completedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@map("payouts")
}

model KycSubmission {
  id                String    @id @default(uuid())
  userId            String
  status            KycStatus @default(NOT_SUBMITTED)
  fullName          String?
  dateOfBirth       DateTime?
  address           String?   @db.Text
  city              String?
  country           String?
  postalCode        String?
  documentType      String?
  documentNumber    String?
  documentFrontUrl  String?   @db.Text
  documentBackUrl   String?   @db.Text
  selfieUrl         String?   @db.Text
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNotes       String?   @db.Text
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_submissions")
}

model PlatformSettings {
  id                  String   @id @default(uuid())
  key                 String   @unique
  value               String   @db.Text
  description         String?  @db.Text
  category            String?
  isPublic            Boolean  @default(false)
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("platform_settings")
}

